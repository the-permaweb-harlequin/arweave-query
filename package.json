{
  "name": "@arweave-query/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for querying data on arweave",
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "cd packages/core && pnpm build",
    "test": "cd packages/core && pnpm test",
    "test:run": "cd packages/core && pnpm test:run",
    "test:integration": "cd packages/core && pnpm test:integration",
    "test:integration:node": "cd packages/core && pnpm test:integration:node",
    "test:integration:browser": "cd packages/core && pnpm test:integration:browser",
    "lint": "cd packages/core && pnpm lint",
    "lint:fix": "cd packages/core && pnpm lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "cd packages/core && pnpm type-check",
    "clean": "cd packages/core && pnpm clean && nx reset",
    "clean:metadata": "./scripts/clean-metadata.sh",
    "dev": "cd packages/core && pnpm dev",
    "codegen": "graphql-codegen --config graphql/codegen.yml",
    "codegen:watch": "graphql-codegen --config graphql/codegen.yml --watch",
    "codegen:parquet": "tsx scripts/codegen-parquet-types.ts",
    "changeset": "changeset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky install",
    "ci": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:run && pnpm build"
  },
  "devDependencies": {
    "@atticusofsparta/waddler": "^0.1.3",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@duckdb/node-api": "1.4.0-r.1",
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@nx/devkit": "^17.3.2",
    "@nx/eslint": "^17.3.2",
    "@nx/eslint-plugin": "17.3.2",
    "@nx/js": "^17.3.2",
    "@nx/node": "^17.3.2",
    "@nx/react": "^17.3.2",
    "@nx/vite": "^17.3.2",
    "@nx/workspace": "^17.3.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chalk": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "nx": "^17.3.2",
    "prettier": "^3.6.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.2"
  },
  "workspaces": [
    "packages/*",
    "packages/frameworks/*"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ar.io/wayfinder-core": "^1.4.3",
    "memory-level": "^3.1.0"
  }
}
