{
  "name": "@arweave-query/cli",
  "version": "0.0.0",
  "description": "CLI for querying Arweave data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "arweave-query": "./bin/run.js"
  },
  "files": [
    "dist",
    "bin",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "pnpm build && oclif manifest && oclif readme"
  },
  "dependencies": {
    "@arweave-query/core": "workspace:*",
    "@oclif/core": "^3.15.1",
    "@oclif/plugin-help": "^6.0.8",
    "@oclif/plugin-plugins": "^4.1.8",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@oclif/test": "^3.1.3",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.4",
    "oclif": "^4.1.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "oclif": {
    "bin": "arweave-query",
    "dirname": "arweave-query",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "query": {
        "description": "Query Arweave transactions"
      },
      "tx": {
        "description": "Transaction operations"
      }
    }
  }
}
