{
  "name": "@arweave-query/core",
  "version": "0.0.0",
  "description": "Core client and provider interfaces for querying Arweave data",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-permaweb-harlequin/arweave-query.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/the-permaweb-harlequin/arweave-query#readme",
  "bugs": {
    "url": "https://github.com/the-permaweb-harlequin/arweave-query/issues"
  },
  "keywords": [
    "arweave",
    "query",
    "graphql",
    "parquet",
    "blockchain",
    "permaweb"
  ],
  "author": "the-permaweb-harlequin",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "require": "./dist/web.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "pnpm test:integration:node && pnpm test:integration:browser",
    "test:integration:node": "vitest run --config vitest.config.integration.ts",
    "test:integration:browser": "vitest run --config vitest.config.browser.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,sql}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,sql}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atticusofsparta/waddler": "^0.1.3",
    "@duckdb/duckdb-wasm": "^1.28.0",
    "duckdb": "^0.9.2",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "graphql-tag": "^2.12.6",
    "level": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@vitest/browser": "^1.0.4",
    "playwright": "^1.40.1",
    "prettier": "^3.0.0",
    "prettier-plugin-sql": "^0.18.0",
    "testcontainers": "^10.4.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
