{
  "name": "@arweave-query/core",
  "version": "0.0.0",
  "description": "Core client and provider interfaces for querying Arweave data",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./web": {
      "import": "./dist/web.js",
      "types": "./dist/web.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,sql}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,sql}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@atticusofsparta/waddler": "^0.1.3",
    "@duckdb/duckdb-wasm": "^1.28.0",
    "duckdb": "^0.9.2",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "graphql-tag": "^2.12.6",
    "level": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "prettier": "^3.0.0",
    "prettier-plugin-sql": "^0.18.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.8",
    "vite-plugin-dts": "^3.6.4",
    "vitest": "^1.0.4"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
